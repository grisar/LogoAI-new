# LogoAI Backend Environment Variables

# API base (internal)
API_BASE=http://0.0.0.0:3000/api

# Server
HOST=0.0.0.0
PORT=3000
NODE_ENV=production

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_here

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/logoai?schema=public

# Redis (for Bull queue)
REDIS_URL=redis://localhost:6379

# Cloudflare Workers AI
CF_API_TOKEN=your_cloudflare_api_token_here
CF_ACCOUNT_ID=your_cloudflare_account_id_here

# Rate Limiting (per user per month)
RATE_LIMIT_FREE=3
RATE_LIMIT_BASIC=50
RATE_LIMIT_PRO=999999

# CORS
CORS_ORIGIN=*
