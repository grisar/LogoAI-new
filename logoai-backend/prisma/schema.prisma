generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(uuid())
  name              String?  @db.VarChar(100)
  email             String   @unique @db.VarChar(255)
  passwordHash      String   @db.Text
  plan              Plan     @default(free)
  generationsUsed   Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  projects          Project[]
  logos             Logo[]
  generationJobs    GenerationJob[]

  @@map("users")
}

model Project {
  id           String     @id @default(uuid())
  userId       String
  name         String     @db.VarChar(100)
  status       ProjectStatus @default(draft)
  isFavorite   Boolean    @default(false)
  thumbnailUrl String?    @db.Text
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logos        Logo[]
  generationJobs GenerationJob[]

  @@index([userId])
  @@map("projects")
}

model Logo {
  id                  String   @id @default(uuid())
  projectId           String
  userId              String
  svgContent          String?  @db.Text
  thumbnailUrl        String   @db.Text
  bgColor             String   @db.VarChar(20)
  brandName           String   @db.VarChar(100)
  style               String   @db.VarChar(50)
  industry            String   @db.VarChar(50)
  isPublic            Boolean  @default(false)
  generationParams    Json?
  createdAt           DateTime @default(now())

  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
  @@index([isPublic])
  @@map("logos")
}

model GenerationJob {
  id              String          @id @default(uuid())
  userId          String
  projectId       String
  status          JobStatus       @default(pending)
  progress        Int             @default(0)
  params          Json
  resultLogoIds   String[]
  errorMessage    String?         @db.Text
  createdAt       DateTime        @default(now())
  completedAt     DateTime?

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([projectId])
  @@index([status])
  @@map("generation_jobs")
}

enum Plan {
  free
  basic
  pro
}

enum ProjectStatus {
  draft
  done
}

enum JobStatus {
  pending
  processing
  done
  failed
}